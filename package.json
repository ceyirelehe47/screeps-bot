{
  "name": "screeps",
  "version": "2026.8.29-2",
  "description": "Screeps local development workspace",
  "main": "dist/main.js",
  "scripts": {
    "build": "rollup -c",
    "push": "rollup -c --environment DEST:main",
    "local": "rollup -c --environment DEST:local",
    "watch": "rollup -cw",
    "typecheck": "npm run typecheck:build && npm run typecheck:test",
    "typecheck:build": "tsc -p tsconfig.build.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.json --noEmit",
    "monitor:serve": "node scripts/monitor-service.mjs",
    "monitor:once": "node scripts/monitor-service.mjs --once",
    "test": "jest --config jest.config.cjs",
    "test:budget": "node scripts/verify-jest-budget.mjs",
    "test-c": "jest --config jest.config.cjs --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@screeps/common": "^2.15.5",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^3.10.1",
    "@types/node": "^25.3.0",
    "@types/screeps": "^3.3.8",
    "jest": "^29.7.0",
    "lodash": "^3.10.1",
    "rollup": "^4.59.0",
    "rollup-plugin-clear": "^2.0.7",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-screeps": "^1.0.1",
    "rollup-plugin-typescript2": "^0.36.0",
    "source-map": "^0.6.1",
    "ts-jest": "^29.4.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}
