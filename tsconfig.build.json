{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "types": ["screeps", "node", "lodash"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/__tests__/**"
  ]
}
