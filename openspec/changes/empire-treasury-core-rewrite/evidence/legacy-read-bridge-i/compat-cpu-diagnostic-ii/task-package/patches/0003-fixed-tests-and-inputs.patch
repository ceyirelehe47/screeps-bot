+test('fixed profile has four fresh points with unchanged budget and bounded absolute window',()=>{
+ const p=K.profileFor(73646525);assert.deepEqual(K.dueTicks(p),[73646700,73646800,73646900,73647000]);assert.equal(p.maxSampleCpu,2);assert.equal(p.reserveCpu,5);});
+for(const field of ['maxSampleCpu','endTick','intervalTicks','minBucket','reserveCpu'])test('profile rejects changed '+field,()=>{const p=K.profileFor(1000);p[field]++;assert.throws(()=>K.validProfile(p));});
+test('raw JSON is not destructively entity-decoded',()=>{const text=JSON.stringify({kind:'treasury-legacy-read-bridge',note:'&#x22; &amp;'});assert.equal(D.parseBridge(text).jsonText,text);assert.equal(D.parseBridge(text).report.note,'&#x22; &amp;');});
+for(const entity of ['&quot;','&#34;','&#x22;','&#X22;'])test('accepts one transport escape layer '+entity,()=>{const text=JSON.stringify({kind:'treasury-legacy-read-bridge',tick:1});const p=D.parseBridge(text.replaceAll('"',entity));assert.equal(p.kind,'bridge');assert.equal(p.jsonText,text);});
+test('double encoded JSON is rejected rather than recursively repaired',()=>{const t=JSON.stringify({kind:'treasury-legacy-read-bridge'}).replaceAll('"','&amp;#x22;');assert.equal(D.parseBridge(t).kind,'invalid');});
+for(const entity of ['&#x110000;','&#xD800;','&#0;','&#99999999999;'])test('bad Unicode entity fails '+entity,()=>assert.throws(()=>D.decodeHtmlOnce(entity)));
+test('actual old partial report is decoded but never a complete sample or new diagnostic',()=>{const r=require('../references/0003-first-report.json'),p=D.parseBridge(JSON.stringify(r).replaceAll('"','&#x22;'));assert.equal(p.kind,'bridge');assert.equal(p.report.status,'partial_cpu_budget');assert.equal(W.sampleError(p.report,K.profileFor(1000)),'SAMPLE_NOT_COMPLETE');});
+test('actual accepted CPU reader emits four valid prefix and three linked tail profiles',()=>{const s=F.session(),a=F.reports(s);assert.equal(a.length,4);a.forEach((r,i)=>{assert.equal(W.diagnosticError(r,s.profile,i,a[i-1],i?JSON.stringify(a[i-1]):null),null);assert.equal(W.sampleError(r,s.profile),null);});});
