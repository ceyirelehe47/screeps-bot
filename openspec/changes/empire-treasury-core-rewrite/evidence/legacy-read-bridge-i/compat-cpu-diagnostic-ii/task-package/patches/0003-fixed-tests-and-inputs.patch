+ ['wrong source',r=>r.sourceCommit='e'.repeat(40)],['future cost',r=>r.cpuProfile.phases.emit=1],['invalid phase',r=>r.cpuProfile.phases.unknown=0],
+ ['bad call count',r=>r.cpuProfile.calls.readerLoad=2],['nonfinite',r=>r.cpuProfile.elapsed=NaN],['mismatched total',r=>r.cpuBeforeSerializationAndEmit=0.9],
+ ['not fresh',r=>r.previousRun={}],['core mismatch',r=>r.endpoints[0].coreComparison='mismatch'],['output limited',r=>r.status='output_limited'],
+ ['room scope',r=>r.scope.rooms=['W1N1']],['unsafe phase cost',r=>{r.cpuProfile.elapsed=6;r.cpuProfile.phases={legacyInputs:6};r.cpuBeforeSerializationAndEmit=6;}]
