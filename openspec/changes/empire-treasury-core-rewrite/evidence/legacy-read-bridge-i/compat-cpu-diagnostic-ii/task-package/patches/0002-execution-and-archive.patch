+  const head=U.textGit(compat,['rev-parse','HEAD']);if(U.textGit(compat,['rev-parse','HEAD^'])!==K.COMPAT||U.textGit(compat,['diff','--name-only',K.COMPAT,head])!==K.CONFIG)C.fail('PROFILE_COMMIT_SCOPE_INVALID');
