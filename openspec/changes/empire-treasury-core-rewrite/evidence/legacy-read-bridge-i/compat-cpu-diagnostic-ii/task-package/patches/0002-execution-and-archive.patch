+  S.newRecord(run,'backup.json',backup);S.newRecord(run,'candidate.json',candidate);
+  const s={kind:K.KIND,runId,...C.EXPECTED,refactorBase:K.REFACTOR,compatBase:K.COMPAT,observedTick:live.time,
