+ ||U.textGit(compat,['diff','--name-only','HEAD^','HEAD'])!==K.CONFIG||U.textGit(compat,['diff','--name-only',K.COMPAT,'HEAD^'])!==K.CONFIG)C.fail('COMPAT_NOT_EXACT_OFF_CLOSE');return head;
