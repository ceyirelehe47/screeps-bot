+ if(!C.same(files.filter(n=>n!=='ARCHIVE-MANIFEST.json').sort(),Object.keys(m.files).sort()))C.fail('ARCHIVE_FILE_SET_CHANGED');
+ if(m.kind!=='cpu-diagnostic-II-archive/v1'||m.refactorBase!==K.REFACTOR||m.compatBase!==K.COMPAT||m.packageFingerprint!==C.sha256(fs.readFileSync(path.join(U.ROOT,'INTEGRITY.json'))))C.fail('ARCHIVE_IDENTITY_CHANGED');
