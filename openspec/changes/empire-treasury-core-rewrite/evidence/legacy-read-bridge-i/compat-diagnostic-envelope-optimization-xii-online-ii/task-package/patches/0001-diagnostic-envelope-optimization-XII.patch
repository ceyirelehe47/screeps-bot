+  a.attributionBoundary(0.06); a.attributionWork({ observationRooms: 2, observationLocations: 4 });
+  a.checkpoint(0.4, 'serializationAndSize'); a.checkpoint(0.6, 'emit'); a.checkpoint(0.7, 'retention'); a.checkpoint(0.75);
