  if(!obj(result)||result.kind!=='collector-result-v2'||result.runId!==s.runId
    ||!['closed','failed'].includes(result.status)||!Number.isSafeInteger(result.exitCode)
    ||typeof result.reason!=='string'||!/^[a-z0-9_]{1,64}$/.test(result.reason))return 'collector_result_invalid';
  return 'collector_exit_'+result.reason;
