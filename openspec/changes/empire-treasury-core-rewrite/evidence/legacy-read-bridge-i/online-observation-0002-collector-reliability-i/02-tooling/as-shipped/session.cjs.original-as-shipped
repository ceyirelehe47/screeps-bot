function heartbeatReason(h,s,now,{maxAgeMs=10000,maxSilenceMs=45000,collectorResult}={}) {
  const terminal=collectorResultReason(collectorResult,s);if(terminal)return terminal;
  if(!obj(h)||h.runId!==s.runId||!Number.isSafeInteger(h.pid)||h.pid<=0
    ||h.userId!==s.userId||h.shard!==s.shard)return 'collector_heartbeat_missing_or_foreign';
  if(h.stopReason)return 'collector_reported_failure';
  if(h.state!=='streaming')return h.state==='closed'||h.state==='failed'?'collector_terminal_without_result':'collector_not_streaming';
  if(h.socketState!==undefined&&h.socketState!=='open')return 'collector_socket_not_streaming';
  if(!Number.isFinite(h.updatedAtMs)||h.updatedAtMs>now+1000||now-h.updatedAtMs>maxAgeMs)return 'collector_heartbeat_stale';
  if(!Number.isFinite(h.lastConsoleAtMs))return 'collector_console_never_seen';
