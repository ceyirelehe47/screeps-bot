+'use strict';
+const C=require('./common.cjs'),D=require('./decoder.cjs'),W=require('../vendor/0003/samples.cjs');
+/** Parse receipt first; acceptance is a separate decision. No budget or completeness relaxation. */
+function replay(text,s){
