+test('changing both nonanchor source bytes and manifest cannot bypass pinned tree identity',()=>{const x=setup();try{U.materialize(x.repo,x.out,x.p);const f=path.join(x.out,'run/entry-4.json');fs.writeFileSync(f,'changed');const m=C.json(path.join(x.out,'MANIFEST.json')),e=m.files.find(f=>f.name==='entry-4.json'),b=C.bytes(f);Object.assign(e,{bytes:b.length,sha256:C.sha256(b),blob:C.blob(b)});fs.writeFileSync(path.join(x.out,'MANIFEST.json'),JSON.stringify(m));assert.throws(()=>U.verifySource(x.out,x.p),{code:'SOURCE_MANIFEST_TREE_MISMATCH'});}finally{x.clean();}});
