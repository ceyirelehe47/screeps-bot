+test('original records are immutable except the additional once-only marker',async()=>{const x=await scenario();try{x.options.observer=async opts=>{fs.appendFileSync(path.join(x.prior,'collector-result.json'),' ');return F.fastObserver(opts);};const r=await x.execute();assert.equal(r.failure.error,'PRIOR_BYTES_CHANGED');assert.equal(r.bytesConfirmed,false);}finally{x.clean();}});
+test('existing output directory is not overwritten',async()=>{const x=await scenario();try{fs.mkdirSync(x.out);fs.writeFileSync(path.join(x.out,'keep'),'old');await assert.rejects(x.execute(),{code:'OUTPUT_ALREADY_EXISTS'});assert.equal(x.w.posts,0);assert.equal(fs.readFileSync(path.join(x.out,'keep'),'utf8'),'old');}finally{x.clean();}});
+test('verifier refuses a forged success with wrong backup digest',async()=>{const x=await scenario();try{await x.execute();const f=path.join(x.out,'code-after-runtime.json'),a=C.json(f);a.digest.hash='0'.repeat(64);fs.writeFileSync(f,JSON.stringify(a));assert.throws(()=>V.verifyClosure(x.out,x.s,{runtimeMs:250,silenceMs:1000}),{code:'BACKUP_READBACK_MISMATCH'});}finally{x.clean();}});
