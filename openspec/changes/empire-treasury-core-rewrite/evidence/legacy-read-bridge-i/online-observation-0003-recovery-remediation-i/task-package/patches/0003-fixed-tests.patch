+ for(const [n,b]of Object.entries(special))fs.writeFileSync(path.join(run,n),b);for(let i=0;i<25;i++)fs.writeFileSync(path.join(run,`entry-${i}.json`),'{}\n');
+ F.git(repo,['add','.']);F.git(repo,['commit','-qm','fixture']);const refactor=F.git(repo,['rev-parse','HEAD']),runTree=F.git(repo,['rev-parse','HEAD:evidence/run']);
