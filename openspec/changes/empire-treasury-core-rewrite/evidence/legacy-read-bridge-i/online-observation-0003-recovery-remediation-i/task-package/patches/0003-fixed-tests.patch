+ return {root,repo,p,out:path.join(root,'source'),clean:()=>fs.rmSync(root,{recursive:true,force:true})};}
+test('materialization reconstructs an actual pinned Git tree with exact bytes',()=>{const x=setup();try{assert.equal(U.materialize(x.repo,x.out,x.p).files,29);assert.equal(U.verifySource(x.out,x.p).runTree,x.p.runTree);}finally{x.clean();}});
