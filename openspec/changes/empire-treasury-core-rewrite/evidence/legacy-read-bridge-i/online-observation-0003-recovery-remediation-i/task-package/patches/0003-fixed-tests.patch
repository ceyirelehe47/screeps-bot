+test('independent observer verifier rejects duplicate footer',async()=>{const t=await run();try{const f=path.join(t.out,'runtime-console.jsonl'),rows=V.jsonl(f);fs.appendFileSync(f,JSON.stringify(rows.at(-1))+'\n');assert.throws(()=>V.verifyObserver(t.out,t.closureId,t.parentRunId,{runtimeMs:250,silenceMs:1000}));}finally{fs.rmSync(t.out,{recursive:true,force:true});}});
+test('independent observer verifier rejects PID substitution',async()=>{const t=await run();try{const f=path.join(t.out,'runtime-console.jsonl'),rows=V.jsonl(f);rows[2].pid++;fs.writeFileSync(f,rows.map(x=>JSON.stringify(x)).join('\n')+'\n');assert.throws(()=>V.verifyObserver(t.out,t.closureId,t.parentRunId,{runtimeMs:250,silenceMs:1000}));}finally{fs.rmSync(t.out,{recursive:true,force:true});}});
