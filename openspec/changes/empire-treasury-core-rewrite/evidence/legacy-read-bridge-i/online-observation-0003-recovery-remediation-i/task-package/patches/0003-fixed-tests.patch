+async function run(mode='healthy'){const out=F.root(),closureId='abc',parentRunId='parent';const r=await O.observeRuntime({out,closureId,parentRunId,secret:F.secret,
+ WebSocketClass:F.wsClass(mode),durationMs:250,startupMs:1500,silenceMs:1000,pollMs:5});return {out,r,closureId,parentRunId};}
+test('new recovery stream independently proves runtime after old collector has exited',async()=>{const t=await run();try{assert.equal(t.r.status,'RECOVERY_RUNTIME_COLLECTED');assert.equal(V.verifyObserver(t.out,t.closureId,t.parentRunId,{runtimeMs:250,silenceMs:1000}).status,'RECOVERY_RUNTIME_INDEPENDENTLY_VERIFIED');}finally{fs.rmSync(t.out,{recursive:true,force:true});}});
