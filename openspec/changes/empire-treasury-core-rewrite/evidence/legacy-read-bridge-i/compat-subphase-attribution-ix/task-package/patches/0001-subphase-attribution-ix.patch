+}
+export function compatUtf8Bytes(s: string): number {
+  let n = 0;
+  for (let i = 0; i < s.length; i++) {
+    const a = s.charCodeAt(i);
+    if (a < 128) n++;
+    else if (a < 2048) n += 2;
+    else if (a >= 0xd800 && a <= 0xdbff && i + 1 < s.length
+      && s.charCodeAt(i + 1) >= 0xdc00 && s.charCodeAt(i + 1) <= 0xdfff) { n += 4; i++; }
