+export const COMPAT_COMMITMENT_MARKS = Object.freeze([
+  "parentStart", "callStart", "bodyStart", "bodyEnd", "callEnd", "parentEnd",
+] as const);
+export type CompatCommitmentMark = typeof COMPAT_COMMITMENT_MARKS[number];
+export interface CompatCommitmentEnvelope {
+  readonly version: 1;
+  readonly status: "not_called" | "complete" | "incomplete";
+  /** Offsets from this sample's start; consecutive differences are inclusive.
