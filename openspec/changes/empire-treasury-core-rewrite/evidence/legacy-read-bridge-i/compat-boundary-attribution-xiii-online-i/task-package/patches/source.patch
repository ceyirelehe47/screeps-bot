@@ -67 +79 @@ export interface CompatCpuProfile {
-export function createCompatCpuAccounting(start: number, tick: number, sampleOrdinal: number) {
+export function createCompatCpuAccounting(start: number, tick: number, sampleOrdinal: number, traceCommitment = false) {
@@ -80,0 +93,16 @@ export function createCompatCpuAccounting(start: number, tick: number, sampleOrd
+  const commitmentMarks: Partial<Record<CompatCommitmentMark, number>> = {};
+  let markIndex = -1, markLast = start;
