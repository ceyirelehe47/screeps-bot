+      if (traceTasks && attributionActive === "commitmentTasks" && next === "commitmentReservations") taskMark("tasksEnd", used);
+      if (traceCommitment && next === "commitmentSetup") mark("bodyStart", used);
+      if (traceCommitment && attributionActive === "commitmentFinalize" && next === undefined) mark("bodyEnd", used);
