+  });
+  return {
+    taskMark(name: "firstPendingStart" | "firstPendingEnd", used: number, ordinal: number): void { taskMark(name, used, ordinal); },
+    commitmentMark(name: "callStart" | "callEnd", used: number): void { mark(name, used); },
+    checkpoint(used: number, next?: CompatCpuPhase): void {
