+      const reservations = table(memory, ["runtime", "resourceReservations"]);
+      const marker = pathValue(memory, ["runtime", "resourceReservationsOwnerVersion"]);
+      const existingCore = pathValue(memory, ["runtime", "treasuryCore"]);
