+const preview = createTreasuryCompatPreview(TREASURY_COMPAT_CONFIG, {
+  tick: () => Game.time,
+  shard: () => Game.shard.name,
+  cpu: () => ({ used: Game.cpu.getUsed(), tickLimit: Game.cpu.tickLimit, bucket: Game.cpu.bucket }),
+  room: name => Game.rooms[name],
