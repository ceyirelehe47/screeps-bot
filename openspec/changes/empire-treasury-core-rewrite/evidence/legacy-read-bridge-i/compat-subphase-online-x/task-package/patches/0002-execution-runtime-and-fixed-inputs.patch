+  room: name => Game.rooms[name],
+  memory: () => Memory,
+  resources: () => RESOURCES_ALL,
+  readers: createCompatibilityReadCore,
+  emit: line => console.log(line),
+}, { cpuDiagnostics: true });
+export function runTreasuryCompatRead(): void { preview.run(); }
