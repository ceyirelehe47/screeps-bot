+});
+
+test('slow raw persistence/audit cannot hide a >1s pause delay',async()=>{
+  const f=fixture();
+  for(let t=cfg.targetTick-2;t<cfg.targetTick+20;t++)f.c.ingest(envelope(sample(t)));
